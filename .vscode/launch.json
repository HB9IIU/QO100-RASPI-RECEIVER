            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0.0"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "preLaunchTask": "build-qo100-monitor-debug"
        },
        {
            "name": "Debug QO-100 DATV",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/qo100_lvgl/build-debug/qo100datv",
            "cwd": "${workspaceFolder}/qo100_lvgl/build-debug",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0.0"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "preLaunchTask": "build-qo100-monitor-debug"
        }
    ]
}
