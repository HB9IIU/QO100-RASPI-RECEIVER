{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug QO-100 DATV",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/qo100_sdl/build-debug/qo100sdl",
            "cwd": "${workspaceFolder}/qo100_sdl/build-debug",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0.0"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "preLaunchTask": "build-qo100-sdl-debug"
        }
    ]
}
