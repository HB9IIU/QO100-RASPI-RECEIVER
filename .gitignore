# macOS junk
.DS_Store
._*

# Python
.venv/
__pycache__/
*.pyc

# Local tooling (self-extracted CLIs etc.)
.tools/

# Build artifacts
build/
build-debug/
build-release/
*.o
*.d

# Local RTL-SDR server development artifacts
rtl-sdr-server-source/.venv-build/
rtl-sdr-server-source/dist/
rtl-sdr-server-source/tools/build/
rtl-sdr-server-source/reports/

# Vendored third-party deps (large, fetch separately if needed)
qo100_lvgl/lvgl/
longmynd_ws/web/libwebsockets/

# Compiled binaries from longmynd_ws
longmynd_ws/longmynd
longmynd_ws/fake_read
longmynd_ws/ts_analyse

# Runtime artifacts (pidfile, named pipes) from running longmynd_ws
*.pid
longmynd_ws/longmynd_main_status
longmynd_ws/longmynd_main_ts

# User-specific runtime settings (LNB LO offset, bias voltage) - code has
# sensible defaults baked in, see load_settings() in qo100datv.cpp
qo100_sdl/settings.json

# User-saved Manual Tune presets - starts empty, nothing to seed in git
qo100_sdl/tune_presets.json

# Logs
*.log

# SNAP button output / ad-hoc diagnostic screenshots
screenshots/

# Editor/OS temp
*~
*.swp

# Claude Code's own local settings/permissions - machine-specific, not
# project config
.claude/

# Per-run app logs
qo100_sdl/logs/
